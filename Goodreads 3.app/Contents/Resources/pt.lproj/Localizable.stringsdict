<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld books</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld livro</string>
			<key>other</key>
			<string>%lld livros</string>
		</dict>
	</dict>
	<key>%lld entries</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld entrada</string>
			<key>other</key>
			<string>%lld entradas</string>
		</dict>
	</dict>
	<key>%lld likes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld gosto</string>
			<key>other</key>
			<string>%lld gostos</string>
		</dict>
	</dict>
	<key>%lld pages</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld página</string>
			<key>other</key>
			<string>%lld páginas</string>
		</dict>
	</dict>
	<key>%lld stars</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld estrela</string>
			<key>other</key>
			<string>%lld estrelas</string>
		</dict>
	</dict>
	<key>Exported %lld books to %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@ para %2$@.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld livro exportado</string>
			<key>other</key>
			<string>%1$lld livros exportados</string>
		</dict>
	</dict>
	<key>Exported %lld books to %@. Couldn’t read: %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@ para %2$@. Não foi possível ler: %3$@.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld livro exportado</string>
			<key>other</key>
			<string>%1$lld livros exportados</string>
		</dict>
	</dict>
	<key>Known for %lld of %lld books read.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Dados de %1$lld de %2$#@b@.</string>
		<key>b</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld livro lido</string>
			<key>other</key>
			<string>%2$lld livros lidos</string>
		</dict>
	</dict>
	<key>Nothing finished in the last %lld days — mark a book read and this fills in.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Nada terminado %#@d@ — marca um livro como lido e isto enche-se.</string>
		<key>d</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>no último dia</string>
			<key>other</key>
			<string>nos últimos %lld dias</string>
		</dict>
	</dict>
	<key>from %lld finished in %lld days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>de %1$#@f@ em %2$#@d@</string>
		<key>d</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld dia</string>
			<key>other</key>
			<string>%2$lld dias</string>
		</dict>
		<key>f</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld terminado</string>
			<key>other</key>
			<string>%1$lld terminados</string>
		</dict>
	</dict>
	<key>of %lld books</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>de %#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld livro</string>
			<key>other</key>
			<string>%lld livros</string>
		</dict>
	</dict>
</dict>
</plist>
